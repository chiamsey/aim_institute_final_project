import random 

class Character:
    def __init__(self, name, health=100, energy=100, experience=0, level=1):
        self.name = name
        self.health = health
        self.energy = energy
        self.experience = experience
        self.level = level

    def __repr__(self):
        return (f"{self.name}: Health: {self.health}, Energy: {self.energy}, "
                f"Experience: {self.experience}, Level: {self.level}")

    def attack(self, target):
        pass

    def block(self):
        pass

class Hero(Character):
    def __init__(self, name):
        super().__init__(name, experience=0, level=1)

    def attack(self, target, weapon):
        if self.energy >= 5:
            self.energy -= 5
            self.experience += 1
            if weapon == 'sword':
                target.health -= 5
                print(f"{self.name} attacks {target.name} with a sword!")
            elif weapon == 'tackle':
                target.health -= 3
                print(f"{self.name} tackles {target.name}!")
            self.level_up()
        else:
            print(f"{self.name} does not have enough energy to attack.")

    def level_up(self):
        if self.experience % 5 == 0:
            self.level += 1
            print(f"{self.name} leveled up to level {self.level}!")

    def block(self):  #Hero blocks, -2 energy
        self.energy -= 2
        print(f"{self.name} blocks the attack!")

class Monster(Character):
    def __init__(self, name):
        super().__init__(name, experience=10, level=3)

    def attack(self, target):
        if self.energy >= 10:
            self.energy -= 10
            target.health -= 15
            print(f"{self.name} attacks {target.name}!")
        else:
            print(f"{self.name} does not have enough energy to attack.")

    def block(self):  #Monster blocks, -5 energy
        self.energy -= 5
        print(f"{self.name} blocks the attack!")

def stats(hero, monster):
    print(hero)
    print(monster)

