class Character:
    def __init__(self, name, experience, level, health=100, energy=100):
        self.name = name
        self.health = health
        self.energy = energy
        self.experience = experience
        self.level = level
    
    def attack(self):
        pass

class Hero(Character): 
    def __init__(self, name):
        super().__init__(name, experience=0, level=1)

    def attack(self):
        if self.energy >= 5:
            self.energy -= 5
            self.experience += 1
            print(f"{self.name} attacks monster!")
            self.level()
        else:
            print(f"{self.name} does not have enough energy to attack.")

class Monster(Character): 
    def __init__(self, name):
        super().__init__(name, experience=10, level=3)

    def attack(self):
        if self.energy >= 10:
            self.energy -= 10
            print(f"{self.name} attacks hero!")
        else:
            print(f"{self.name} does not have enough energy to attack.")